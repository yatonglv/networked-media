<html>
    <head>
        <title>Today's Lucky Tip</title>
    </head>
    <body>
        <h1>Today's Lucky Tip</h1>
        <form method="POST" action="/add-data">
            <label>Today you can try:</label>
            <input type="text" name="good" placeholder="eg.wearing mismatched socks">
          
            <label>Today you better not:</label>
            <input type="text" name="avoid" placeholder="eg. getting your hair cut">
            <input type="submit" value="send data">
        </form>
    </body>
</html>